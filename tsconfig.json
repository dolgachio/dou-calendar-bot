{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false
  },
  "include": ["src/**/*", "apps/bot/src/config", "apps/bot/src/constants", "apps/bot/src/data", "apps/bot/src/menu", "apps/bot/src/types", "apps/bot/src/create-bot.ts", "apps/bot/src/index.ts"],
  "exclude": ["node_modules"]
}
